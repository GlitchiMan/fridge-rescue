{
  "name": "fridge-rescue",
  "version": "0.1.0",
  "private": true,
  "description": "Turn what's in your fridge into something delicious.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "images:sync": "node scripts/sync-images.mjs",
    "trends:refresh": "node scripts/refresh-trends.mjs",
    "predev": "node scripts/sync-images.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-images.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:data": "vitest run tests/unit/data-validation.test.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
