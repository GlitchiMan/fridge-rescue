# Public URL of the deployed site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact email shown on /contact. Leave empty to show a "not configured" notice.
NEXT_PUBLIC_CONTACT_EMAIL=

# Advertising is OFF by default. Only enable after AdSense approval.
NEXT_PUBLIC_ADS_ENABLED=false
# Your AdSense publisher ID, e.g. ca-pub-XXXXXXXXXXXXXXXX (never commit a made-up one).
NEXT_PUBLIC_ADSENSE_CLIENT=
# Developer-only: show clearly-labelled grey placeholders where ads would go.
NEXT_PUBLIC_SHOW_AD_PLACEHOLDERS=false

# ── Optional server-side integrations (never prefix these with NEXT_PUBLIC_) ──
# YouTube video search (free quota). Both are required.
YOUTUBE_ENABLED=false
YOUTUBE_API_KEY=
# Protects the trend refresh endpoint. Use a long random string.
CRON_SECRET=
# Shared store, required on Netlify for trends and AI spend limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# AI answers (PAID, billed by Anthropic). Stays off unless all are set.
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_DAILY_BUDGET_USD=1
AI_PER_USER_DAILY_LIMIT=20
